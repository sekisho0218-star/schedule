{
  "name": "vertical-techo-desktop",
  "productName": "VerticalTecho",
  "version": "1.7.0",
  "description": "週間バーチカル手帳（Windows デスクトップ版）",
  "author": "sekisho",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "jp.sekisho.vertical.desktop",
    "productName": "VerticalTecho",
    "files": [
      "main.js",
      "preload.js",
      "google.js",
      "config.js",
      "shift.js",
      "shiftsync.js",
      "renderer/**",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "バーチカル手帳",
      "artifactName": "VerticalTecho-Setup.${ext}"
    }
  }
}
